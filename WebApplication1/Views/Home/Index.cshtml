@{
    ViewData["Title"] = "TickEvent";
}

<section class="hero">
    <div class="wrap">
        <div class="eyebrow">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
            Every detail, ticked off
        </div>
        <h1>Everything your event needs.<br><em>One tick at a time.</em></h1>
        <p class="sub">Venues, photographers, makeup artists, planners and more — vetted, reviewed, and ready to book across the country.</p>

        <div class="search-panel">
            <div class="search-field">
                <label>Service</label>
                <div class="val">What are you looking for?</div>
            </div>
            <div class="search-field">
                <label>Location</label>
                <div class="val">City or postcode</div>
            </div>
            <div class="search-field">
                <label>Date</label>
                <div class="val">Add event date</div>
            </div>
            <button class="search-btn">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                Search
            </button>
        </div>
    </div>
</section>

<div class="trust">
    <div class="wrap">
        <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2l3 6 6 1-4.5 4.5L18 20l-6-3-6 3 1.5-6.5L3 9l6-1z"></path></svg> ID-verified vendors</span>
        <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="11" width="18" height="10" rx="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg> Secure booking & payment</span>
        <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg> Support until the last guest leaves</span>
    </div>
</div>

<section class="section">
    <div class="wrap">
        <div class="section-head">
            <div class="kicker">Browse by category</div>
            <h2>Start with what you need, we'll handle the rest</h2>
        </div>
        <div class="cat-grid">
            <div class="cat-card">
                <div class="cat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6"></path></svg></div>
                <div><div class="cat-name">Venues</div><div class="cat-count">1,240 listed</div></div>
            </div>
            <div class="cat-card">
                <div class="cat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg></div>
                <div><div class="cat-name">Photographers</div><div class="cat-count">860 listed</div></div>
            </div>
            <div class="cat-card">
                <div class="cat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"></circle><path d="M9 12l2 2 4-4"></path></svg></div>
                <div><div class="cat-name">Makeup artists</div><div class="cat-count">540 listed</div></div>
            </div>
            <div class="cat-card">
                <div class="cat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l2.5 6.5L21 9l-5 4.5L17.5 21 12 17l-5.5 4L8 13.5 3 9l6.5-.5z"></path></svg></div>
                <div><div class="cat-name">Event planners</div><div class="cat-count">410 listed</div></div>
            </div>
            <div class="cat-card">
                <div class="cat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="8" cy="18" r="2"></circle><circle cx="17" cy="18" r="2"></circle><path d="M2 3h2l2.6 13.4a2 2 0 0 0 2 1.6h8.8a2 2 0 0 0 2-1.6L21 6H6"></path></svg></div>
                <div><div class="cat-name">Catering</div><div class="cat-count">720 listed</div></div>
            </div>
            <div class="cat-card">
                <div class="cat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18V5l12-2v13M9 9l12-2M6 21a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM18 19a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"></path></svg></div>
                <div><div class="cat-name">DJs & musicians</div><div class="cat-count">390 listed</div></div>
            </div>
            <div class="cat-card">
                <div class="cat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="14" rx="2"></rect><path d="M8 21h8M12 18v3"></path></svg></div>
                <div><div class="cat-name">Decor & styling</div><div class="cat-count">280 listed</div></div>
            </div>
            <div class="cat-card">
                <div class="cat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="7" width="16" height="13" rx="2"></rect><path d="M9 7V4h6v3M4 12h16"></path></svg></div>
                <div><div class="cat-name">Kids' parties</div><div class="cat-count">195 listed</div></div>
            </div>
        </div>
    </div>
</section>

<section class="section how">
    <div class="wrap">
        <div class="section-head">
            <div class="kicker">How it works</div>
            <h2>From idea to booked, in three steps</h2>
        </div>
        <div class="how-grid">
            <div class="how-step">
                <div class="tick-badge"><svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></div>
                <h3>Browse and compare</h3>
                <p>Search by category, location and date. Filter by price, style and availability across every vendor type you need.</p>
            </div>
            <div class="how-step">
                <div class="tick-badge"><svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></div>
                <h3>Book and pay securely</h3>
                <p>Send a request, agree the details in-app, and pay through TickEvent. Your booking is protected end to end.</p>
            </div>
            <div class="how-step">
                <div class="tick-badge"><svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></div>
                <h3>Celebrate, worry-free</h3>
                <p>Every vendor is reviewed and verified. If plans change, our support team is with you before, during and after.</p>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="wrap">
        <div class="section-head">
            <div class="kicker">Handpicked for you</div>
            <h2>Featured this month</h2>
        </div>
        <div class="vendor-grid">
            <div class="vendor-card">
                <div class="vendor-img">
                    <div class="verified-badge"><svg viewBox="0 0 24 24" fill="none" stroke="#12291F" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>Verified</div>
                    <span class="vendor-cat">Venue</span>
                </div>
                <div class="vendor-body">
                    <h3>The Willowmere Estate</h3>
                    <div class="vendor-meta">Berkshire · up to 180 guests</div>
                    <div class="vendor-foot">
                        <div class="vendor-rating"><svg viewBox="0 0 24 24"><polygon points="12 2 15 9 22 9.5 17 14.5 18.5 22 12 18 5.5 22 7 14.5 2 9.5 9 9"></polygon></svg>4.9 (86)</div>
                        <div class="vendor-price">from £3,200</div>
                    </div>
                </div>
            </div>
            <div class="vendor-card">
                <div class="vendor-img">
                    <div class="verified-badge"><svg viewBox="0 0 24 24" fill="none" stroke="#12291F" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>Verified</div>
                    <span class="vendor-cat">Photographer</span>
                </div>
                <div class="vendor-body">
                    <h3>Maren Cole Photography</h3>
                    <div class="vendor-meta">London · full-day coverage</div>
                    <div class="vendor-foot">
                        <div class="vendor-rating"><svg viewBox="0 0 24 24"><polygon points="12 2 15 9 22 9.5 17 14.5 18.5 22 12 18 5.5 22 7 14.5 2 9.5 9 9"></polygon></svg>5.0 (142)</div>
                        <div class="vendor-price">from £850</div>
                    </div>
                </div>
            </div>
            <div class="vendor-card">
                <div class="vendor-img">
                    <div class="verified-badge"><svg viewBox="0 0 24 24" fill="none" stroke="#12291F" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>Verified</div>
                    <span class="vendor-cat">Makeup artist</span>
                </div>
                <div class="vendor-body">
                    <h3>Studio Amara</h3>
                    <div class="vendor-meta">Manchester · bridal & events</div>
                    <div class="vendor-foot">
                        <div class="vendor-rating"><svg viewBox="0 0 24 24"><polygon points="12 2 15 9 22 9.5 17 14.5 18.5 22 12 18 5.5 22 7 14.5 2 9.5 9 9"></polygon></svg>4.8 (63)</div>
                        <div class="vendor-price">from £180</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section section-compact">
    <div class="wrap">
        <div class="vendor-cta">
            <div>
                <h2>Run an event business? Get discovered.</h2>
                <p>Join thousands of vendors getting booked through TickEvent. List free, set your own availability and pricing, get paid securely.</p>
            </div>
            <a href="#" class="btn-gold">List your business</a>
        </div>
    </div>
</section>

