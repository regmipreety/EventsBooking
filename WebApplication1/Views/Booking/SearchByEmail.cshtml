
@{
    ViewData["Title"] = "Search Bookings by Email";
}

<h1>Search Bookings by Email</h1>

<form asp-controller="Booking" asp-action="GetBookingByEmail" method="post">
    @Html.AntiForgeryToken()
    <div class="form-group mb-4">
        <label for="userEmail">Email</label>
        <input type="email" id="userEmail" name="userEmail" class="form-control" placeholder="Enter email" required />
    </div>
    <div class="form-group mt-3">
        <input type="submit" value="Search" class="btn btn-primary" />
    </div>
</form>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}