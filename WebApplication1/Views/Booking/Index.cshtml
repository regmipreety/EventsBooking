@model List<WebApplication1.Models.Entities.Booking>
    @if(TempData["BookingSuccess"] != null)
    {
        <div class="alert alert-success">@TempData["BookingSuccess"]</div>
    }
    @if(TempData["BookingError"] != null)
    {
        <div class="alert alert-danger">@TempData["BookingError"]</div>
    }
<h1>My Bookings</h1>

@if (!Model.Any())
{
    <p>No bookings yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Event</th>
                <th>User</th>
                <th>Booked At</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var booking in Model)
            {
                <tr>
                    <td>@booking.Event?.Name</td>
                    <td>@booking.UserId</td>
                    <td>@booking.BookingDate.ToString("MMM dd, yyyy h:mm tt")</td>
                    <td>@booking.Status</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@booking.Id" class="btn btn-sm btn-secondary">Details</a>
                        <a asp-action="Edit" asp-route-id="@booking.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="CancelBooking" asp-route-id="@booking.Id" class="btn btn-sm btn-danger">Cancel</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}    